# Copy to .env, fill only the key. Never commit .env.
DDL_PROVIDER=qiniu
QINIU_API_KEY=
DDL_MODEL=deepseek/deepseek-v4.1-flash
DDL_ENDPOINT=https://api.qnaigc.com/v1
# Optional fallback: set provider=deepseek, model=deepseek-flash,
# endpoint=https://api.deepseek.com and fill the separate key below.
DEEPSEEK_API_KEY=
# Optional absolute path to codex.exe if it is not on PATH.
DDL_CODEX_BIN=

# Server environment variables. Export in your shell; Python does not auto-load this file.
# Never put model credentials in VITE_* variables.
HARNESS_URL=
HARNESS_TOKEN=
TEXT_HARNESS_URL=
TEXT_HARNESS_TOKEN=
# NIUMA_DB=/absolute/path/to/niuma.sqlite3
