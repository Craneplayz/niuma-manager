# Copy to .env, fill only the key. Never commit .env.
DEEPSEEK_API_KEY=
DDL_MODEL=deepseek-flash
DDL_ENDPOINT=https://api.deepseek.com
# Optional absolute path to codex.exe if it is not on PATH.
DDL_CODEX_BIN=

# Server environment variables. Export in your shell; Python does not auto-load this file.
# Never put model credentials in VITE_* variables.
HARNESS_URL=
HARNESS_TOKEN=
TEXT_HARNESS_URL=
TEXT_HARNESS_TOKEN=
# NIUMA_DB=/absolute/path/to/niuma.sqlite3
