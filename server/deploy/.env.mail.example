# Alibaba Cloud DirectMail. Copy to each environment's private .env.mail.
# No variable expansion or inline comments; values are literal. Never commit secrets.
# Select the SMTP endpoint for the region used in the DirectMail console.
# Hangzhou: smtpdm.aliyun.com; Singapore: smtpdm-ap-southeast-1.aliyuncs.com
# Virginia: smtpdm-us-east-1.aliyuncs.com; Frankfurt: smtpdm-eu-central-1.aliyuncs.com
# A Hong Kong ECS server still uses one of the DirectMail regions above.
NIUMA_MAIL_HOST=smtpdm.aliyun.com
NIUMA_MAIL_PORT=465
# This address is also the SMTP login, created as a trigger sender in DirectMail.
NIUMA_MAIL_FROM=
# The sender's dedicated SMTP password, not an AccessKey or Alibaba Cloud login.
NIUMA_MAIL_PASSWORD=
NIUMA_MAIL_TIMEOUT=10

# Zero-extra-cost deployments: explicitly verified remaining free quota only.
# Both environments use the SAME existing external niuma-mail-budget volume.
# NIUMA_MAIL_BUDGET_FILE=/mail-budget/quota.sqlite3
# NIUMA_MAIL_BUDGET_DAILY=100
# NIUMA_MAIL_BUDGET_TOTAL=1000
