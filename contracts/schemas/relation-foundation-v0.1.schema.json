{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "context": {
      "type": "object",
      "properties": {
        "contract_version": {
          "const": "relation-foundation/0.1"
        },
        "scope_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "source_account_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "term_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "input_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10000
              },
              "course_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "content_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "term_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "label": {
                "type": "string",
                "maxLength": 1024
              },
              "course_name": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 1024
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "url": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 8192
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "starts_on": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "ends_on": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "snapshot_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "revision": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "parts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "part_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "label": {
                      "type": "string",
                      "maxLength": 1024
                    },
                    "text": {
                      "type": "string",
                      "maxLength": 24000
                    },
                    "read_state": {
                      "enum": [
                        "complete",
                        "partial",
                        "unread",
                        "unsupported",
                        "failed"
                      ]
                    },
                    "revision": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "sha256": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^[0-9a-f]{64}$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "part_id",
                    "label",
                    "text",
                    "read_state",
                    "revision",
                    "sha256"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 100,
                "minItems": 0
              },
              "submission": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "state": {
                        "enum": [
                          "active",
                          "submitted",
                          "unknown"
                        ]
                      },
                      "basis": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      },
                      "snapshot_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      },
                      "sequence": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "control_revision": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "review_pending": {
                        "type": "boolean"
                      },
                      "scope": {
                        "enum": [
                          "submission_only",
                          "mixed",
                          "unknown"
                        ]
                      },
                      "control_digest": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      }
                    },
                    "required": [
                      "state",
                      "basis",
                      "snapshot_id",
                      "sequence",
                      "control_revision",
                      "review_pending",
                      "scope",
                      "control_digest"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "id",
              "input_id",
              "course_id",
              "content_id",
              "term_id",
              "label",
              "course_name",
              "url",
              "starts_on",
              "ends_on",
              "snapshot_id",
              "revision",
              "parts",
              "submission"
            ],
            "additionalProperties": false
          },
          "maxItems": 20,
          "minItems": 1
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "kind": {
                "enum": [
                  "task",
                  "candidate"
                ]
              },
              "binding_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "state": {
                "type": "string",
                "maxLength": 64
              },
              "label": {
                "type": "string",
                "maxLength": 1024
              },
              "revision": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "source_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "maxItems": 20,
                "minItems": 1
              },
              "protected": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "kind",
              "binding_id",
              "state",
              "label",
              "revision",
              "source_ids",
              "protected"
            ],
            "additionalProperties": false
          },
          "maxItems": 200,
          "minItems": 0
        },
        "transitions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "candidate_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "task_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "basis": {
                "const": "saved_history"
              }
            },
            "required": [
              "candidate_id",
              "task_id",
              "basis"
            ],
            "additionalProperties": false
          },
          "maxItems": 500,
          "minItems": 0
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 128
          },
          "maxItems": 100,
          "minItems": 0
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "contract_version",
        "scope_id",
        "source_account_id",
        "term_id",
        "sources",
        "actions",
        "transitions",
        "warnings",
        "revision"
      ],
      "additionalProperties": false
    },
    "relation": {
      "type": "object",
      "properties": {
        "contract_version": {
          "const": "relation-foundation/0.1"
        },
        "context_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "kind": {
          "enum": [
            "duplicate",
            "complement",
            "bundle",
            "independent"
          ]
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "maxItems": 20,
          "minItems": 2
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "role": {
                "enum": [
                  "content",
                  "submission",
                  "correction",
                  "reference"
                ]
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "source_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "part_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "part_revision": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "offset": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4000
                    }
                  },
                  "required": [
                    "source_id",
                    "part_id",
                    "part_revision",
                    "offset",
                    "quote"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 30,
                "minItems": 1
              }
            },
            "required": [
              "source_id",
              "role",
              "evidence"
            ],
            "additionalProperties": false
          },
          "maxItems": 40,
          "minItems": 2
        },
        "units": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "channel": {
                "type": "string",
                "maxLength": 128
              },
              "action_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "maxItems": 200,
                "minItems": 0
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "source_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "part_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "part_revision": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "offset": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4000
                    }
                  },
                  "required": [
                    "source_id",
                    "part_id",
                    "part_revision",
                    "offset",
                    "quote"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 30,
                "minItems": 1
              }
            },
            "required": [
              "id",
              "label",
              "channel",
              "action_ids",
              "evidence"
            ],
            "additionalProperties": false
          },
          "maxItems": 50,
          "minItems": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "part_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "part_revision": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "offset": {
                "type": "integer",
                "minimum": 0
              },
              "quote": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            },
            "required": [
              "source_id",
              "part_id",
              "part_revision",
              "offset",
              "quote"
            ],
            "additionalProperties": false
          },
          "maxItems": 30,
          "minItems": 1
        },
        "coverage": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "unit_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "maxItems": 50,
                "minItems": 1
              },
              "extent": {
                "enum": [
                  "complete",
                  "partial",
                  "unknown"
                ]
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "source_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "part_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "part_revision": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "offset": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4000
                    }
                  },
                  "required": [
                    "source_id",
                    "part_id",
                    "part_revision",
                    "offset",
                    "quote"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 30,
                "minItems": 1
              }
            },
            "required": [
              "source_id",
              "unit_ids",
              "extent",
              "evidence"
            ],
            "additionalProperties": false
          },
          "maxItems": 50,
          "minItems": 0
        },
        "deadline": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "date": {
                  "type": "string",
                  "format": "date"
                },
                "time": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "source_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      },
                      "part_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      },
                      "part_revision": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "offset": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "quote": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4000
                      }
                    },
                    "required": [
                      "source_id",
                      "part_id",
                      "part_revision",
                      "offset",
                      "quote"
                    ],
                    "additionalProperties": false
                  },
                  "maxItems": 30,
                  "minItems": 1
                }
              },
              "required": [
                "date",
                "time",
                "evidence"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "contract_version",
        "context_revision",
        "kind",
        "source_ids",
        "roles",
        "units",
        "evidence",
        "coverage",
        "deadline"
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/context"
    },
    {
      "$ref": "#/$defs/relation"
    }
  ]
}
