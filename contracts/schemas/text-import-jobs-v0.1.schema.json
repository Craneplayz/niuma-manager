{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "text-import-jobs-v0.1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "jobs"
  ],
  "properties": {
    "contract_version": {
      "const": "text-import-jobs/0.1"
    },
    "jobs": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/job"
      }
    }
  },
  "$defs": {
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "state",
        "attempt",
        "created_at",
        "updated_at",
        "error"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "state": {
          "enum": [
            "queued",
            "recognizing",
            "success",
            "no_tasks",
            "partial_success",
            "failed",
            "stopped",
            "interrupted"
          ]
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "error": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "code",
                "message",
                "retryable"
              ],
              "additionalProperties": false,
              "properties": {
                "input_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "code": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "message": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "retryable": {
                  "type": "boolean"
                }
              }
            }
          ]
        }
      }
    }
  }
}
