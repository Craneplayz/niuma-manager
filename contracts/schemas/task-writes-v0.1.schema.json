{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "operation": {
      "type": "object",
      "required": [
        "id",
        "owner",
        "intent"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{16,100}$"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "intent": {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "save",
                "status",
                "deadline",
                "trash",
                "restore",
                "review",
                "bulk"
              ]
            },
            "workspaceGeneration": {
              "type": "integer",
              "minimum": 0
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "review"
                  }
                }
              },
              "then": {
                "$ref": "#/$defs/reviewIntent"
              }
            },
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "bulk"
                  }
                }
              },
              "then": {
                "$ref": "#/$defs/bulkIntent"
              }
            }
          ]
        }
      }
    },
    "reconcile": {
      "type": "object",
      "required": [
        "owner",
        "operations"
      ],
      "additionalProperties": false,
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "operations": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/operation"
          }
        }
      }
    },
    "reviewIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "candidateId",
        "action",
        "expectedCandidateVersion"
      ],
      "properties": {
        "kind": {
          "const": "review"
        },
        "candidateId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "action": {
          "enum": [
            "create",
            "update",
            "postpone",
            "cancel",
            "ignore",
            "reopen"
          ]
        },
        "expectedCandidateVersion": {
          "type": "integer",
          "minimum": 1
        },
        "workspaceGeneration": {
          "type": "integer",
          "minimum": 0
        },
        "draft": {
          "type": "object"
        },
        "targetId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "expectedTarget": {
          "type": "object",
          "required": [
            "title",
            "description",
            "course",
            "content_type",
            "due",
            "status",
            "completedAt"
          ],
          "additionalProperties": false,
          "properties": {
            "title": {},
            "description": {},
            "course": {},
            "content_type": {},
            "due": {},
            "status": {},
            "completedAt": {}
          }
        },
        "newTaskId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{16,100}$"
        },
        "complete": {
          "type": "boolean"
        },
        "completedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "createdAt": {
          "type": "string",
          "maxLength": 100
        },
        "previewSource": {
          "type": "string",
          "maxLength": 200
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "enum": [
                  "create",
                  "update",
                  "postpone"
                ]
              }
            }
          },
          "then": {
            "required": [
              "draft"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "enum": [
                  "update",
                  "postpone",
                  "cancel"
                ]
              }
            }
          },
          "then": {
            "required": [
              "targetId",
              "expectedTarget"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "create"
              }
            }
          },
          "then": {
            "required": [
              "newTaskId"
            ]
          }
        },
        {
          "if": {
            "required": [
              "complete"
            ],
            "properties": {
              "complete": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "completedAt"
            ],
            "properties": {
              "action": {
                "const": "create"
              }
            }
          }
        }
      ]
    },
    "bulkIntent": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "bulk"
            },
            "workspaceGeneration": {
              "type": "integer",
              "minimum": 0
            },
            "action": {
              "enum": [
                "complete",
                "reopen",
                "deadline",
                "trash",
                "restore"
              ]
            },
            "tasks": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "expected": {
                    "type": "object",
                    "properties": {
                      "title": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 20000
                      },
                      "notes": {
                        "type": "string",
                        "maxLength": 100000
                      },
                      "course": {
                        "type": "string",
                        "maxLength": 20000
                      },
                      "content_type": {
                        "enum": [
                          "task",
                          "notice"
                        ]
                      },
                      "due": {
                        "anyOf": [
                          {
                            "const": ""
                          },
                          {
                            "type": "string",
                            "format": "date",
                            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                          }
                        ]
                      },
                      "dueTime": {
                        "type": "string",
                        "pattern": "^(?:|(?:[01]\\d|2[0-3]):[0-5]\\d)$"
                      },
                      "status": {
                        "enum": [
                          "todo",
                          "doing",
                          "done"
                        ]
                      },
                      "completedAt": {
                        "anyOf": [
                          {
                            "const": ""
                          },
                          {
                            "type": "string",
                            "format": "date",
                            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                          }
                        ]
                      }
                    },
                    "required": [
                      "title",
                      "notes",
                      "course",
                      "content_type",
                      "due",
                      "dueTime",
                      "status",
                      "completedAt"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "id",
                  "expected"
                ],
                "additionalProperties": false
              },
              "maxItems": 500
            },
            "candidates": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "version": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "taskId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{16,100}$"
                  },
                  "expected": {
                    "type": "object",
                    "properties": {
                      "title": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 20000
                      },
                      "notes": {
                        "type": "string",
                        "maxLength": 100000
                      },
                      "course": {
                        "type": "string",
                        "maxLength": 20000
                      },
                      "content_type": {
                        "enum": [
                          "task",
                          "notice"
                        ]
                      },
                      "due": {
                        "anyOf": [
                          {
                            "const": ""
                          },
                          {
                            "type": "string",
                            "format": "date",
                            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                          }
                        ]
                      },
                      "dueTime": {
                        "type": "string",
                        "pattern": "^(?:|(?:[01]\\d|2[0-3]):[0-5]\\d)$"
                      },
                      "status": {
                        "enum": [
                          "todo",
                          "doing",
                          "done"
                        ]
                      },
                      "completedAt": {
                        "anyOf": [
                          {
                            "const": ""
                          },
                          {
                            "type": "string",
                            "format": "date",
                            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                          }
                        ]
                      }
                    },
                    "required": [
                      "title",
                      "notes",
                      "course",
                      "content_type",
                      "due",
                      "dueTime",
                      "status",
                      "completedAt"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "id",
                  "version",
                  "taskId",
                  "expected"
                ],
                "additionalProperties": false
              },
              "maxItems": 500
            },
            "date": {
              "anyOf": [
                {
                  "const": ""
                },
                {
                  "type": "string",
                  "format": "date",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                }
              ]
            },
            "completedAt": {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "deletedAt": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "kind",
            "action",
            "workspaceGeneration",
            "tasks",
            "candidates"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "bulk"
            },
            "workspaceGeneration": {
              "type": "integer",
              "minimum": 0
            },
            "action": {
              "const": "undo"
            },
            "undoOf": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{16,100}$"
            }
          },
          "required": [
            "kind",
            "workspaceGeneration",
            "action",
            "undoOf"
          ],
          "additionalProperties": false
        }
      ]
    },
    "bulkUndo": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "bulk"
        },
        "workspaceGeneration": {
          "type": "integer",
          "minimum": 0
        },
        "action": {
          "const": "undo"
        },
        "undoOf": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{16,100}$"
        }
      },
      "required": [
        "kind",
        "workspaceGeneration",
        "action",
        "undoOf"
      ],
      "additionalProperties": false
    },
    "bulkResult": {
      "type": "object",
      "properties": {
        "operationId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{16,100}$"
        },
        "undo": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/bulkUndo"
            }
          ]
        }
      },
      "required": [
        "operationId",
        "undo"
      ],
      "additionalProperties": false
    },
    "reconciled": {
      "type": "object",
      "properties": {
        "applied": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{16,100}$"
          }
        },
        "tasks": {
          "type": "object",
          "properties": {
            "value": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "version": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "value",
            "version"
          ],
          "additionalProperties": false
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "state": {
                "enum": [
                  "pending",
                  "applied",
                  "ignored",
                  "missing"
                ]
              },
              "version": {
                "type": "integer",
                "minimum": 0
              },
              "taskId": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "state",
              "version"
            ],
            "additionalProperties": false
          }
        },
        "generation": {
          "type": "integer",
          "minimum": 0
        },
        "bulkResults": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bulkResult"
          }
        }
      },
      "required": [
        "applied",
        "tasks",
        "candidates",
        "generation"
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/operation"
    },
    {
      "$ref": "#/$defs/reconcile"
    },
    {
      "$ref": "#/$defs/reconciled"
    }
  ]
}
