{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Content-free producer observation",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "stage", "duration_ms", "result_code"],
      "properties": {
        "contract_version": {"const": "producer-observation/0.1"},
        "stage": {"const": "attachment_download"},
        "duration_ms": {"type": "number", "minimum": 0},
        "result_code": {"enum": ["ok", "download_failed"]}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "stage", "duration_ms", "result_code", "input_tokens", "output_tokens", "total_tokens"],
      "properties": {
        "contract_version": {"const": "producer-observation/0.1"},
        "stage": {"const": "model_call"},
        "duration_ms": {"type": "number", "minimum": 0},
        "result_code": {"enum": ["ok", "timeout", "rate_limited", "http_error", "invalid_response", "unavailable"]},
        "input_tokens": {"type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991},
        "total_tokens": {"type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991}
      }
    }
  ]
}
