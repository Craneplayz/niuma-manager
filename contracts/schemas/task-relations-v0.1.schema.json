{
  "type": "object",
  "properties": {
    "contract_version": {
      "const": "task-relations/0.1"
    },
    "context_digest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "relation": {
            "enum": [
              "duplicate",
              "combine",
              "update"
            ]
          },
          "disposition": {
            "enum": [
              "apply",
              "review"
            ]
          },
          "members": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "uniqueItems": true,
            "maxItems": 24,
            "minItems": 2
          },
          "result": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "description": {
                "type": "string",
                "minLength": 0,
                "maxLength": 4096
              },
              "course": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "minLength": 0,
                    "maxLength": 512
                  }
                ]
              },
              "content_type": {
                "enum": [
                  "task",
                  "notice"
                ]
              },
              "due": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "date": {
                        "type": "string",
                        "minLength": 10,
                        "maxLength": 10
                      },
                      "time": {
                        "anyOf": [
                          {
                            "type": "null"
                          },
                          {
                            "type": "string",
                            "minLength": 5,
                            "maxLength": 5
                          }
                        ]
                      }
                    },
                    "required": [
                      "date",
                      "time"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "required": [
              "title",
              "description",
              "course",
              "content_type",
              "due"
            ],
            "additionalProperties": false
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 24,
            "items": {
              "type": "object",
              "properties": {
                "node_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "quote": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1200
                }
              },
              "required": [
                "node_id",
                "quote"
              ],
              "additionalProperties": false
            }
          },
          "completion": {
            "type": "array",
            "maxItems": 24,
            "items": {
              "type": "object",
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "covers": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  },
                  "uniqueItems": true,
                  "maxItems": 24,
                  "minItems": 1
                }
              },
              "required": [
                "source_id",
                "covers"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "relation",
          "disposition",
          "members",
          "result",
          "reason",
          "evidence",
          "completion"
        ],
        "additionalProperties": false
      },
      "maxItems": 12
    }
  },
  "required": [
    "contract_version",
    "context_digest",
    "groups"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
