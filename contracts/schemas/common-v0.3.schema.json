{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:niuma:contracts:common:0.3",
  "title": "Shared text and attachment definitions v0.3",
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "\\S"
    },
    "instant": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d+)?(?:Z|[+-]\\d\\d:\\d\\d)$"
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "precision",
        "basis"
      ],
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "precision": {
          "enum": [
            "datetime",
            "date",
            "unknown"
          ]
        },
        "basis": {
          "enum": [
            "source",
            "upstream_unverified",
            "unknown"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "precision": {
                "const": "unknown"
              }
            },
            "required": [
              "precision"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              },
              "basis": {
                "const": "unknown"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "precision": {
                "const": "date"
              }
            },
            "required": [
              "precision"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "format": "date",
                "pattern": "^\\d{4}-\\d\\d-\\d\\d$"
              },
              "basis": {
                "enum": [
                  "source",
                  "upstream_unverified"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "precision": {
                "const": "datetime"
              }
            },
            "required": [
              "precision"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "format": "date-time",
                "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d+)?(?:Z|[+-]\\d\\d:\\d\\d)$"
              },
              "basis": {
                "enum": [
                  "source",
                  "upstream_unverified"
                ]
              }
            }
          }
        }
      ]
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page",
        "paragraph",
        "bbox"
      ],
      "properties": {
        "page": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "paragraph": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "bbox": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "minItems": 4,
              "maxItems": 4
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "block_id",
        "text",
        "locator",
        "method",
        "quality",
        "quality_notes"
      ],
      "properties": {
        "block_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "maxLength": 100000
        },
        "locator": {
          "$ref": "#/$defs/locator"
        },
        "method": {
          "enum": [
            "native",
            "ocr"
          ]
        },
        "quality": {
          "enum": [
            "normal",
            "uncertain"
          ]
        },
        "quality_notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "quality": {
                "const": "uncertain"
              }
            },
            "required": [
              "quality"
            ]
          },
          "then": {
            "properties": {
              "quality_notes": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "quality": {
                "const": "normal"
              }
            },
            "required": [
              "quality"
            ]
          },
          "then": {
            "properties": {
              "quality_notes": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "complete",
        "unread_locations",
        "truncated"
      ],
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "unread_locations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "truncated": {
          "type": "boolean"
        }
      }
    },
    "attachment_error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "code",
        "message",
        "retryable"
      ],
      "properties": {
        "stage": {
          "enum": [
            "collect",
            "extract"
          ]
        },
        "code": {
          "enum": [
            "asset_missing",
            "decrypt_failed",
            "unsupported_type",
            "limit_exceeded",
            "parse_failed",
            "ocr_failed",
            "incomplete_content"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "retryable": {
          "type": "boolean"
        }
      }
    },
    "attachment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "file_name",
        "mime_type",
        "size_bytes",
        "sha256",
        "origin",
        "original_published_at",
        "status",
        "extractor_version",
        "coverage",
        "blocks",
        "errors"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        },
        "file_name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "maxLength": 255
        },
        "mime_type": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "size_bytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "origin": {
          "enum": [
            "original",
            "forwarded",
            "unknown"
          ]
        },
        "original_published_at": {
          "$ref": "#/$defs/publication"
        },
        "status": {
          "enum": [
            "complete",
            "partial",
            "failed",
            "unsupported"
          ]
        },
        "extractor_version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "coverage": {
          "$ref": "#/$defs/coverage"
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          },
          "maxItems": 1000
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attachment_error"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "complete",
                  "partial"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "mime_type": {
                "enum": [
                  "image/jpeg",
                  "image/png",
                  "application/pdf",
                  "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
                ]
              },
              "extractor_version": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 20971520
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "complete"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "coverage": {
                "properties": {
                  "complete": {
                    "const": true
                  },
                  "unread_locations": {
                    "maxItems": 0
                  },
                  "truncated": {
                    "const": false
                  }
                }
              },
              "errors": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "partial"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "coverage": {
                "properties": {
                  "complete": {
                    "const": false
                  }
                }
              },
              "blocks": {
                "minItems": 1
              },
              "errors": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "failed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "coverage": {
                "properties": {
                  "complete": {
                    "const": false
                  }
                }
              },
              "blocks": {
                "maxItems": 0
              },
              "errors": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "unsupported"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "coverage": {
                "properties": {
                  "complete": {
                    "const": false
                  }
                }
              },
              "blocks": {
                "maxItems": 0
              },
              "errors": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_id",
        "text",
        "published_at",
        "timezone",
        "platform",
        "source_url",
        "source_label"
      ],
      "properties": {
        "input_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        },
        "text": {
          "type": "string",
          "maxLength": 100000
        },
        "published_at": {
          "$ref": "#/$defs/publication"
        },
        "timezone": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "platform": {
          "enum": [
            "teaching_web",
            "wechat",
            "email",
            "web",
            "unknown"
          ]
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_id",
        "text",
        "text_quality",
        "platform",
        "published_at",
        "collected_at",
        "timezone",
        "timezone_basis",
        "source_url",
        "source_label",
        "source_item_id",
        "course_or_project",
        "context",
        "upstream_hints",
        "attachments"
      ],
      "properties": {
        "input_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        },
        "text": {
          "type": "string",
          "maxLength": 100000
        },
        "text_quality": {
          "enum": [
            "complete",
            "partial",
            "summary",
            "missing"
          ]
        },
        "platform": {
          "enum": [
            "teaching_web",
            "wechat",
            "email",
            "web",
            "unknown"
          ]
        },
        "published_at": {
          "$ref": "#/$defs/publication"
        },
        "collected_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d+)?(?:Z|[+-]\\d\\d:\\d\\d)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "timezone": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "timezone_basis": {
          "enum": [
            "source",
            "caller_default",
            "unknown"
          ]
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_item_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "course_or_project": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "context": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/context"
          },
          "maxItems": 100
        },
        "upstream_hints": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "attachments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attachment"
          },
          "maxItems": 10
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "text_quality": {
                "const": "missing"
              }
            }
          },
          "then": {
            "properties": {
              "text": {
                "const": ""
              },
              "attachments": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "text": {
                "pattern": "\\S"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "timezone_basis": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "properties": {
              "timezone": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "timezone": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_id",
        "platform",
        "url",
        "label",
        "source_item_id"
      ],
      "properties": {
        "input_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        },
        "platform": {
          "enum": [
            "teaching_web",
            "wechat",
            "email",
            "web",
            "unknown"
          ]
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_item_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "evidence": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input_id",
            "field",
            "quote",
            "supports"
          ],
          "properties": {
            "input_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "\\S"
            },
            "field": {
              "type": "string",
              "pattern": "^(text|upstream_hints\\.raw\\.[A-Za-z0-9_.-]+)$"
            },
            "quote": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "supports": {
              "$ref": "#/$defs/supports"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input_id",
            "field",
            "asset_id",
            "block_id",
            "quote",
            "supports"
          ],
          "properties": {
            "input_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "\\S"
            },
            "field": {
              "const": "attachment"
            },
            "asset_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "\\S"
            },
            "block_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "\\S"
            },
            "quote": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "supports": {
              "$ref": "#/$defs/supports"
            }
          }
        }
      ]
    },
    "supports": {
      "type": "array",
      "items": {
        "enum": [
          "title",
          "description",
          "prerequisites",
          "course_or_project",
          "notice_type",
          "target_reference",
          "deadline"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "deadline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "precision",
        "timezone",
        "kind",
        "status",
        "raw",
        "basis",
        "alternatives"
      ],
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "precision": {
          "enum": [
            "datetime",
            "date",
            "unknown"
          ]
        },
        "timezone": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "enum": [
            "deadline",
            "reference",
            "unknown"
          ]
        },
        "status": {
          "enum": [
            "explicit",
            "inferred",
            "unknown",
            "conflict",
            "not_provided"
          ]
        },
        "raw": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "basis": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "precision": {
                "const": "datetime"
              }
            },
            "required": [
              "precision"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "format": "date-time",
                "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d+)?(?:Z|[+-]\\d\\d:\\d\\d)$"
              },
              "timezone": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "precision": {
                "const": "date"
              }
            },
            "required": [
              "precision"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "format": "date",
                "pattern": "^\\d{4}-\\d\\d-\\d\\d$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "precision": {
                "const": "unknown"
              }
            },
            "required": [
              "precision"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "explicit"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "kind": {
                "const": "deadline"
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "raw": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "inferred"
              }
