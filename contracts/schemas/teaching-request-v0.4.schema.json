{
  "type": "object",
  "properties": {
    "contract_version": {
      "const": "0.4"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "record": {
            "type": "object",
            "required": [
              "input_id",
              "source_item_id",
              "course_id",
              "snapshot_id",
              "platform",
              "text",
              "body_status",
              "source_metadata_text",
              "references",
              "published_at",
              "collected_at",
              "timezone",
              "course_term"
            ],
            "properties": {
              "input_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
              },
              "source_item_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
              },
              "course_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
              },
              "snapshot_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
              },
              "platform": {
                "const": "teaching_web"
              },
              "text": {
                "type": "string",
                "maxLength": 100000
              },
              "body_status": {
                "enum": [
                  "complete",
                  "partial",
                  "summary",
                  "missing"
                ]
              },
              "source_metadata_text": {
                "type": "string",
                "maxLength": 4096
              },
              "references": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/reference"
                },
                "maxItems": 50
              },
              "published_at": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/publication"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "collected_at": {
                "type": "string",
                "format": "date-time"
              },
              "timezone": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
              },
              "course_context": {
                "$ref": "#/$defs/course_context"
              },
              "course_term": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/term"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "additionalProperties": false
          },
          "source": {
            "type": "object",
            "properties": {
              "label": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "url": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "course_or_project": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "label",
              "url",
              "course_or_project"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "record",
          "source"
        ],
        "additionalProperties": false
      },
      "maxItems": 20
    }
  },
  "required": [
    "contract_version",
    "request_id",
    "records"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "quote": {
      "type": "object",
      "required": [
        "part_id",
        "quote"
      ],
      "properties": {
        "part_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "additionalProperties": false
    },
    "reference": {
      "type": "object",
      "required": [
        "ref_id",
        "kind",
        "label",
        "read_state",
        "text"
      ],
      "properties": {
        "ref_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "kind": {
          "enum": [
            "attachment",
            "content_image",
            "linked_detail",
            "course_context"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "read_state": {
          "enum": [
            "complete",
            "unread",
            "partial",
            "failed",
            "unsupported"
          ]
        },
        "text": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 100000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "course_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "revision",
        "documents",
        "omitted_documents"
      ],
      "properties": {
        "contract_version": {
          "const": "course-context/0.1"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "omitted_documents": {
          "type": "integer",
          "minimum": 0
        },
        "documents": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ref_id",
              "input_id",
              "snapshot_id",
              "course_id",
              "term_id",
              "part_id",
              "source_url",
              "source_label",
              "published_at",
              "offset",
              "length"
            ],
            "properties": {
              "ref_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "input_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "snapshot_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "course_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "term_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "part_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "source_url": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 4096
              },
              "source_label": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 512
              },
              "published_at": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 64
              },
              "offset": {
                "type": "integer",
                "minimum": 0
              },
              "length": {
                "type": "integer",
                "minimum": 1,
                "maximum": 24000
              }
            }
          }
        }
      }
    },
    "term": {
      "type": "object",
      "required": [
        "term_id",
        "starts_on",
        "ends_on",
        "applies_to",
        "evidence"
      ],
      "properties": {
        "term_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "starts_on": {
          "type": "string",
          "format": "date"
        },
        "ends_on": {
          "type": "string",
          "format": "date"
        },
        "applies_to": {
          "enum": [
            "current_assignment",
            "course_material",
            "unknown"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/quote"
          },
          "maxItems": 10
        }
      },
      "additionalProperties": false
    },
    "publication": {
      "type": "object",
      "required": [
        "value",
        "basis"
      ],
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "string",
              "format": "date-time"
            }
          ]
        },
        "basis": {
          "enum": [
            "source",
            "unverified"
          ]
        }
      },
      "additionalProperties": false
    },
    "deadline": {
      "type": "object",
      "required": [
        "value",
        "precision",
        "derivation",
        "anchor",
        "evidence"
      ],
      "properties": {
        "value": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "string",
                  "format": "date-time"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "precision": {
          "enum": [
            "date",
            "datetime",
            "unknown"
          ]
        },
        "derivation": {
          "enum": [
            "absolute",
            "missing_year",
            "relative",
            "offset",
            "course_rule",
            "unresolved",
            "not_provided"
          ]
        },
        "anchor": {
          "enum": [
            null,
            "published_at",
            "collected_at",
            "course_term"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/quote"
          },
          "maxItems": 20
        }
      },
      "additionalProperties": false
    }
  }
}
