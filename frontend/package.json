{
  "name": "niuma-manager",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "node ../scripts/run-python.mjs ../server/app.py",
    "dev:planning": "cd .. && node scripts/run-python.mjs -m server.planning_harness",
    "dev:recognition": "cd .. && node scripts/run-python.mjs -m ddl_text.http_server --real",
    "db:seed": "node ../scripts/run-python.mjs ../server/app.py --seed",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js && cd .. && node scripts/run-python.mjs -m unittest discover -s server -p test_*.py"
  },
  "devDependencies": {
    "vite": "^6.0.0"
  }
}
